{
  "IsRunOnAspire": "true",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.AspNetCore.Authentication": "Debug",
        "Microsoft.AspNetCore.Authorization": "Debug"
      }
    },
    "Enrich": [ "FromLogContext", "WithOpenTelemetrySpanId", "WithOpenTelemetryTraceId" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "OutputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{RequestMethod} {RequestPath} {StatusCode} {Elapsed:0.0000} {NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
